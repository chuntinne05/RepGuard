# ============================================================
# RepGuard Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# ----- LLM Provider API Keys -----
# Leave blank to use the MockProvider (no API calls).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Gemini API key — required for the capability audit with Gemini models.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ----- Provider Selection -----
# Options: mock, openai, anthropic, gemini
# Default: mock (deterministic dry-run, no API keys required)
REPGUARD_PROVIDER=mock

# ----- Default Model IDs -----
REPGUARD_OPENAI_MODEL=gpt-4o-2024-08-06
REPGUARD_ANTHROPIC_MODEL=claude-sonnet-4-20250514
REPGUARD_GEMINI_MODEL=gemini-flash-latest

# ----- Data Directory -----
# Where to store downloaded/cached benchmark data.
# Default: ./data
REPGUARD_DATA_DIR=./data

# ----- LLM Call Cache -----
# Directory for caching LLM responses to avoid redundant API calls.
# Default: ./.llm_cache
REPGUARD_CACHE_DIR=./.llm_cache

# ----- Logging -----
# Directory for structured experiment logs.
# Default: ./logs
REPGUARD_LOG_DIR=./logs
